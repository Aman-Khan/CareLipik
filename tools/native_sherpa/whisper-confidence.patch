 namespace sherpa_onnx {
 
+namespace {
+// Probability of the actual selected token under the same filtered logits used
+// by greedy decoding. Double precision log-sum-exp avoids overflow/underflow.
+float SelectedTokenLogProbability(const float *logits, int32_t size,
+                                  int32_t selected) {
+  float maximum = *std::max_element(logits, logits + size);
+  if (!std::isfinite(maximum) || !std::isfinite(logits[selected])) {
+    return std::numeric_limits<float>::quiet_NaN();
+  }
+  double sum = 0.0;
+  for (int32_t i = 0; i < size; ++i) {
+    sum += std::exp(static_cast<double>(logits[i]) - maximum);
+  }
+  return static_cast<float>(logits[selected] - maximum - std::log(sum));
+}
